# Copy to .env (git-ignored). Keys may also come from the environment.
# run.py --provider chooses the provider; the model comes from config/models.yaml.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional
# LLM_RPM=25              requests per minute (default depends on provider)
# LLM_MAX_RETRIES=12
# LLM_MAX_TOKENS=65536    most output tokens per reply
# LLM_MAX_WAIT=180        longest single backoff in seconds; a longer Retry-After stops the run
# LLM_JSON_MODE=0         1 sends response_format=json_object where the provider supports it
# LLM_TPM=8000            cap prompt + reply to a provider's tokens-per-minute limit
# LLM_TEMPERATURE=0.7     prereg-v1 s5
# LLM_TIMEOUT=900         seconds per request; thinking can take minutes on large matrices
